# DeepSearchStack — Environment Template
# Copy to .env and fill in your values

# --- DeepSeek (primary compute, via inference-gateway) ---
DEEPSEEK_API_KEY=your_deepseek_api_key_here
INFERENCE_GATEWAY_PORT=8005

# --- Groq (fast inference for open-source LLMs, free tier) ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- OpenCode / Zen (free tier, no key required) ---
# Optional: set if you want paid OpenCode models
# OPENCODE_API_KEY=your_opencode_api_key_here

# --- NVIDIA NIM (optional) ---
# NVIDIA_API_KEY=your_nvidia_api_key_here

# --- Database ---
POSTGRES_DB=searchdb
POSTGRES_USER=searchuser
POSTGRES_PASSWORD=searchpass

# --- Search Providers (optional API keys) ---
# Most search backends (SearXNG, Whoogle, YaCy) are self-hosted, no keys needed.

# --- Web API: provider selection (overrides default 7) ---
# Comma-separated list. Default: searxng,wikipedia,stackexchange,hackernews,github,arxiv,yacy
# Note: whoogle/duckduckgo removed (SearXNG covers Google+Bing+DDG).
# Reddit removed (IP-blocked from Docker). Crossref/PubMed/InternetArchive removed (lower priority).
# Available: searxng, wikipedia, stackexchange, hackernews, github, arxiv, yacy, whoogle,
#            duckduckgo, pubmed, crossref, internetarchive, reddit
# Example: AGGREGATE_PROVIDERS=searxng,wikipedia,github,arxiv
# AGGREGATE_PROVIDERS=

# --- Proxy (optional, only for full stack with --profile with-proxy) ---
# CRAWLER_HTTP_PROXY=http://tinyproxy:8888
# CRAWLER_HTTPS_PROXY=http://tinyproxy:8888
# PROXY_ROTATOR_PORT=8030
# TINYPROXY_PORT=8888
