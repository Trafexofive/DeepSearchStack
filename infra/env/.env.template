# DeepSearchStack — Environment Template
# Copy to .dev.env and fill in your values

# --- DeepSeek (primary compute, via inference-gateway) ---
DEEPSEEK_API_KEY=your_deepseek_api_key_here
INFERENCE_GATEWAY_PORT=8005

# --- Database ---
POSTGRES_DB=searchdb
POSTGRES_USER=searchuser
POSTGRES_PASSWORD=searchpass

# --- Logging ---
LOG_LEVEL=INFO

# --- Proxy (optional, only for full stack) ---
# CRAWLER_HTTP_PROXY=http://tinyproxy:8888
# CRAWLER_HTTPS_PROXY=http://tinyproxy:8888
# PROXY_ROTATOR_PORT=8030
# TINYPROXY_PORT=8888
